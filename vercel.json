{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "rewrites": [
    {
      "source": "/tools/calculator",
      "destination": "https://calculator-soypaqari.vercel.app"
    },
    {
      "source": "/tools/calculator/:path*",
      "destination": "https://calculator-soypaqari.vercel.app/:path*"
    }
  ]
}